{{> layout/admin-layout-start}}

<div class="page-header">
    <h2>대시보드</h2>
    <p>시스템 전체 통계를 확인하세요</p>
</div>

<!-- 차트 섹션 -->
<h3 style="margin: 2rem 0 1rem; color: #2c3e50;">📈 통계 차트</h3>
<div class="charts-section">
    <div class="chart-container">
        <h3>회원 및 상담사 현황</h3>
        <canvas id="statsChart"></canvas>
    </div>
    <div class="chart-container">
        <h3>역할별 비율</h3>
        <canvas id="roleChart"></canvas>
    </div>
</div>

<!-- 회원 통계 -->
<h3 style="margin-bottom: 1rem; color: #2c3e50;">👤 회원 통계</h3>
<div class="stats-grid">
    <div class="stat-card primary" onclick="location.href='/api/admin/view/members/list'" style="cursor: pointer;">
        <h3>전체 회원</h3>
        <div class="number">{{stats.totalMembers}}</div>
    </div>
    <div class="stat-card success" onclick="location.href='/api/admin/view/members/active'" style="cursor: pointer;">
        <h3>활성 회원</h3>
        <div class="number">{{stats.activeMembers}}</div>
        <div class="label">정상 이용 중</div>
    </div>
    <div class="stat-card danger" onclick="location.href='/api/admin/view/members/suspended'" style="cursor: pointer;">
        <h3>정지 회원</h3>
        <div class="number">{{stats.suspendedMembers}}</div>
        <div class="label">이용 정지</div>
    </div>
    <div class="stat-card warning" onclick="location.href='/api/admin/view/members/withdrawal'" style="cursor: pointer;">
        <h3>탈퇴 대기</h3>
        <div class="number">{{stats.withdrawalMembers}}</div>
        <div class="label">3개월 내 자동 삭제</div>
    </div>
</div>

<!-- 상담사 통계 -->
<h3 style="margin: 2rem 0 1rem; color: #2c3e50;">💼 상담사 통계</h3>
<div class="stats-grid">
    <div class="stat-card primary" onclick="location.href='/api/admin/view/counselors/list'" style="cursor: pointer;">
        <h3>전체 상담사</h3>
        <div class="number">{{stats.totalCounselors}}</div>
    </div>
    <div class="stat-card success" onclick="location.href='/api/admin/view/counselors/active'" style="cursor: pointer;">
        <h3>활성 상담사</h3>
        <div class="number">{{stats.activeCounselors}}</div>
        <div class="label">상담 가능</div>
    </div>
    <div class="stat-card warning" onclick="location.href='/api/admin/view/counselors/pending'" style="cursor: pointer;">
        <h3>승인 대기</h3>
        <div class="number">{{stats.pendingCounselors}}</div>
        <div class="label">검토 필요</div>
    </div>
</div>

<!-- 역할별 통계 -->
<h3 style="margin: 2rem 0 1rem; color: #2c3e50;">🔑 역할별 통계</h3>
<div class="stats-grid">
    <div class="stat-card info">
        <h3>일반 회원</h3>
        <div class="number">{{stats.userCount}}</div>
        <div class="label">USER</div>
    </div>
    <div class="stat-card info">
        <h3>상담사</h3>
        <div class="number">{{stats.counselorCount}}</div>
        <div class="label">COUNSELOR</div>
    </div>
    <div class="stat-card info">
        <h3>관리자</h3>
        <div class="number">{{stats.adminCount}}</div>
        <div class="label">ADMIN</div>
    </div>
</div>

<!-- 신고 통계 -->
<h3 style="margin: 2rem 0 1rem; color: #2c3e50;">🚨 신고 통계</h3>
<div class="stats-grid">
    <div class="stat-card primary" onclick="location.href='/api/admin/view/reports'" style="cursor: pointer;">
        <h3>전체 신고</h3>
        <div class="number">{{stats.totalReports}}</div>
        <div class="label">게시글 {{stats.postReports}} / 댓글 {{stats.commentReports}}</div>
    </div>
    <div class="stat-card warning" onclick="location.href='/api/admin/view/reports/pending'" style="cursor: pointer;">
        <h3>대기 중</h3>
        <div class="number">{{stats.pendingReports}}</div>
        <div class="label">처리 필요</div>
    </div>
    <div class="stat-card success" onclick="location.href='/api/admin/view/reports/approved'" style="cursor: pointer;">
        <h3>승인됨</h3>
        <div class="number">{{stats.approvedReports}}</div>
        <div class="label">제재 완료</div>
    </div>
    <div class="stat-card danger" onclick="location.href='/api/admin/view/reports/rejected'" style="cursor: pointer;">
        <h3>반려됨</h3>
        <div class="number">{{stats.rejectedReports}}</div>
        <div class="label">신고 기각</div>
    </div>
</div>


<!-- Chart.js 라이브러리 -->
<script>
    const stats = {
        totalMembers: {{stats.totalMembers}},
        activeMembers: {{stats.activeMembers}},
        suspendedMembers: {{stats.suspendedMembers}},
        withdrawalMembers: {{stats.withdrawalMembers}},
        totalCounselors: {{stats.totalCounselors}},
        activeCounselors: {{stats.activeCounselors}},
        pendingCounselors: {{stats.pendingCounselors}},
        userCount: {{stats.userCount}},
        counselorCount: {{stats.counselorCount}},
        adminCount: {{stats.adminCount}}
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => initCharts(stats));
    } else {
        initCharts(stats);
    }
</script>

{{> layout/admin-layout-end}}
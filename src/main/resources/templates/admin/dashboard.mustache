<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>관리자 대시보드</title>
    <link rel="stylesheet" href="/css/admin-common.css">
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
</head>
<body>
<div class="header">
    <h1>관리자 대시보드</h1>
    <nav>
        <a href="/api/admin/view/counselors">상담사 관리</a>
        <a href="/api/admin/view/logout" class="btn btn-danger">로그아웃</a>
    </nav>
</div>

<div class="container">
    <div class="stats-grid">
        <div class="stat-card">
            <h3>전체 회원</h3>
            <div class="number">{{stats.totalMembers}}</div>
        </div>
        <div class="stat-card">
            <h3>전체 상담사</h3>
            <div class="number">{{stats.totalCounselors}}</div>
        </div>
        <div class="stat-card">
            <h3>활성 상담사</h3>
            <div class="number">{{stats.activeCounselors}}</div>
        </div>
        <div class="stat-card">
            <h3>승인 대기</h3>
            <div class="number">{{stats.pendingCounselors}}</div>
        </div>
    </div>

    <div class="chart-container">
        <canvas id="statsChart"></canvas>
    </div>
</div>

<script src="/js/admin-dashboard.js"></script>
<script>
    initChart({
        totalMembers: {{stats.totalMembers}},
            totalCounselors: {{stats.totalCounselors}},
            activeCounselors: {{stats.activeCounselors}},
            pendingCounselors: {{stats.pendingCounselors}}
    });
</script>
</body>
</html>
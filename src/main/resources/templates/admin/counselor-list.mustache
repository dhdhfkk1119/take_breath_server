{{> layout/admin-layout-start}}

<div class="page-header">
    <h2>{{pageTitle}}</h2>
    <p>상담사 정보를 관리하세요</p>
</div>

<!-- 필터 버튼 -->
<div class="filter-buttons">
    <a href="/api/admin/view/counselors/list" class="filter-btn {{#isAllFilter}}active{{/isAllFilter}}">
        전체 상담사
    </a>
    <a href="/api/admin/view/counselors/active" class="filter-btn {{#isActiveFilter}}active{{/isActiveFilter}}">
        활성 상담사
    </a>
    <a href="/api/admin/view/counselors/pending" class="filter-btn {{#isPendingFilter}}active{{/isPendingFilter}}">
        승인 대기
    </a>
</div>

<!-- 상담사 목록 테이블 -->
<div class="table-container">
    <table class="data-table">
        <thead>
        <tr>
            <th>ID</th>
            <th>회원 이메일</th>
            <th>회원 이름</th>
            <th>전문 분야</th>
            <th>가격</th>
            <th>포인트</th>
            <th>상태</th>
            <th>소개</th>
            <th>해시태그</th>
            {{#isPendingFilter}}<th>승인 처리</th>{{/isPendingFilter}}
        </tr>
        </thead>
        <tbody>
        {{#counselors}}
            <tr>
                <td>{{id}}</td>
                <td>{{member.email}}</td>
                <td>{{member.name}}</td>
                <td>{{specialty}}</td>
                <td>{{price}}원</td>
                <td>{{point}}</td>
                <td>
                    {{#isActive}}<span class="badge badge-ACTIVE">활성</span>{{/isActive}}
                    {{#isPending}}<span class="badge badge-PENDING">대기</span>{{/isPending}}
                    {{#isSuspended}}<span class="badge badge-SUSPENDED">정지</span>{{/isSuspended}}
                    {{#isRejected}}<span class="badge badge-REJECTED">거절</span>{{/isRejected}}
                </td>
                <td class="introduction-cell">{{introduction}}</td>
                <td>{{hashtags}}</td>

                {{#isPendingFilter}}
                    <td>
                        <form action="/api/admin/view/counselors/{{id}}/approve" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-success">승인</button>
                        </form>
                        <button type="button" class="btn btn-danger" onclick="openRejectModal({{id}})">거절</button>
                    </td>
                {{/isPendingFilter}}
            </tr>
        {{/counselors}}
        {{^counselors}}
            <tr>
                <td colspan="10" style="text-align: center; padding: 2rem; color: #999;">
                    상담사가 없습니다.
                </td>
            </tr>
        {{/counselors}}
        </tbody>
    </table>
</div>

<!-- 승인/거절 처리 모달 -->
<div id="rejectModal" class="modal" style="display: none;">
    <div class="modal-content">
        <h3>거절 사유 입력</h3>
        <form id="rejectForm" method="post">
            <textarea name="rejectReason" placeholder="거절 사유를 입력해주세요..." required></textarea>
            <div class="modal-buttons">
                <button type="button" class="btn" onclick="closeRejectModal()">취소</button>
                <button type="submit" class="btn btn-danger">거절 확정</button>
            </div>
        </form>
    </div>
</div>

<!-- 자격증 이미지 모달 -->
<div id="imageModal" class="modal" style="display: none;">
    <div class="image-modal-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 id="licenseTitle">자격증 정보</h3>
            <button class="btn btn-danger" onclick="closeImageModal()">닫기</button>
        </div>
        <img id="licenseImageDisplay" src="" alt="자격증 이미지" style="max-width: 100%; height: auto;">
        <div class="license-info">
            <p><strong>자격증명:</strong> <span id="licenseNameDisplay"></span></p>
            <p><strong>자격증 번호:</strong> <span id="licenseNumberDisplay"></span></p>
            <p><strong>등록 번호:</strong> <span id="licenseRegiNumberDisplay"></span></p>
        </div>
    </div>
</div>

{{> layout/admin-layout-end}}

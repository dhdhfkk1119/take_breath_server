{{> layout/admin-layout-start}}

<div class="page-header">
    <h2>{{pageTitle}}</h2>
    <p>커뮤니티 게시판의 카테고리를 관리하세요</p>
</div>

<form method="post" action="/api/admin/view/community/categories" style="margin-bottom: 1rem;">
    <input type="text" name="name" placeholder="새 카테고리 이름" required>
    <button id="addCategoryBtn" class="btn btn-primary">추가</button>
</form>

<div class="table-container">
    <table class="data-table">
        <thead>
        <tr>
            <th>ID</th>
            <th>카테고리명</th>
            <th>생성일</th>
            <th>관리</th>
        </tr>
        </thead>
        <tbody id="categoryList">
        {{#categories}}
            <tr>
                <td>{{id}}</td>
                <td>{{name}}</td>
                <td>
                    <form method="post" action="/api/admin/view/community/categories/{{id}}/delete">
                        <button type="submit" class="btn btn-danger">삭제</button>
                    </form>
                </td>
            </tr>
        {{/categories}}
        {{^categories}}
            <tr><td colspan="4" style="text-align:center;color:#999;">등록된 카테고리가 없습니다.</td></tr>
        {{/categories}}
        </tbody>
    </table>
</div>

{{> layout/admin-layout-end}}

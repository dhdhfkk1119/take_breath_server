{{> layout/admin-layout-start}}

<div class="page-header">
    <h2>{{pageTitle}}</h2>
</div>

<div class="table-container" style="padding:2rem;max-width:700px;margin:auto;">
    <form action="/api/admin/view/audiovisual/register" method="post" class="admin-form">
        <label>유튜브 링크 <span style="color:red">*</span></label>
        <input type="text" name="youtubeUrl" placeholder="예: https://youtu.be/abcd1234xyz" required>

        <p style="font-size:0.9rem;color:#666;margin-top:-0.3rem;margin-bottom:1.2rem;">
            → 유튜브 링크만 입력해도 제목, 설명, 상영시간이 자동으로 등록됩니다.
        </p>

        <label>제목 (선택)</label>
        <input type="text" name="title" placeholder="입력하지 않으면 자동으로 채워집니다.">

        <label>상영 시간 (선택)</label>
        <input type="text" name="duration" placeholder="입력하지 않으면 자동으로 채워집니다.">

        <label>설명 (선택)</label>
        <textarea name="description" rows="4" placeholder="입력하지 않으면 자동으로 채워집니다."></textarea>

        <div style="text-align:right;margin-top:1rem;">
            <button type="submit" class="btn btn-primary">등록</button>
            <a href="/api/admin/view/audiovisual" class="btn">취소</a>
        </div>
    </form>
</div>

{{> layout/admin-layout-end}}

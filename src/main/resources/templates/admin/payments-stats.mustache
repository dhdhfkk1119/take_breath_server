{{> layout/admin-layout-start}}

<div class="page-header">
    <h2>💳 결제 수수료 통계</h2>
    <p>전체 결제 현황 및 월별 추이를 확인하세요</p>
</div>

<!-- 전체 통계 카드 -->
<div class="stats-cards">
    <div class="stats-card">
        <h4>💰 총 결제 금액</h4>
        <p>{{totalStats.formattedTotalPaymentAmount}}원</p>
    </div>
    <div class="stats-card">
        <h4>💸 총 수수료 금액</h4>
        <p>{{totalStats.formattedTotalFeeAmount}}원</p>
    </div>
    <div class="stats-card">
        <h4>🧾 결제 건수</h4>
        <p>{{totalStats.formattedTotalPaymentCount}}건</p>
    </div>
</div>


<!-- 테이블 -->
<div class="table-wrapper">
    <h3 style="padding:1.5rem 1.5rem 0;">🗓️ 월별 결제 수수료 내역</h3>
    <table>
        <thead>
        <tr>
            <th>월</th>
            <th>수수료 금액</th>
            <th>총 결제 금액</th>
            <th>결제 건수</th>
        </tr>
        </thead>
        <tbody>
        {{#monthlyStats}}
            <tr>
                <td>{{month}}</td>
                <td>{{formattedTotalFeeAmount}}원</td>
                <td>{{formattedTotalPaymentAmount}}원</td>
                <td>{{formattedTotalPaymentCount}}</td>
            </tr>
        {{/monthlyStats}}

        {{^monthlyStats}}
            <tr>
                <td colspan="4" class="empty-state">데이터가 없습니다</td>
            </tr>
        {{/monthlyStats}}
        </tbody>
    </table>
</div>

{{> layout/admin-layout-end}}

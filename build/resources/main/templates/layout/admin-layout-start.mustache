<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{pageTitle}}</title>
    <link rel="stylesheet" href="/css/admin-layout.css">
    <link rel="stylesheet" href="/css/admin-common.css">
    {{#additionalCss}}
        <link rel="stylesheet" href="{{.}}">
    {{/additionalCss}}
    {{#additionalScript}}
        <script src="{{.}}"></script>
    {{/additionalScript}}
</head>
<body>
<div class="admin-layout">
    <!-- 사이드바 -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <h1>🔐 관리자</h1>
            <p>TakeBreath Admin</p>
        </div>
        <ul class="sidebar-menu">
            <li>
                <a href="/api/admin/view/dashboard" class="{{#isDashboard}}active{{/isDashboard}}">
                    <span>📊</span> 대시보드
                </a>
            </li>
            <li>
                <a href="/api/admin/view/members" class="{{#isMembers}}active{{/isMembers}}">
                    <span>👥</span> 회원 관리
                </a>
            </li>
            <li>
                <a href="/api/admin/view/counselors" class="{{#isCounselors}}active{{/isCounselors}}">
                    <span>💼</span> 상담사 관리
                </a>
            </li>
            <li>
                <a href="/api/admin/view/reports" class="{{#isReports}}active{{/isReports}}">
                    <span>🚨</span> 신고관리
                </a>
            </li>
        </ul>
        <div class="sidebar-footer">
            <a href="/api/admin/view/logout" class="btn-logout">로그아웃</a>
        </div>
    </aside>

    <!-- 메인 컨텐츠 -->
    <main class="main-content">